/* =========================================================
   ServiceRoute — Kahilom Psychological Services
   Mobile-first, zero-dependency design system
   ========================================================= */

:root {
  /* Brand palette */
  --cream: #FAF8F5;
  --cream-deep: #F3EFE8;
  --sage: #3F5E4D;
  --sage-hover: #324B3E;
  --eucalyptus: #52796F;
  --sage-soft: #EEF4EF;
  --sage-wash: #F5F8F4;
  --amber-tint: #FFF8F0;
  --amber-line: #E0A96D;
  --amber-ink: #7A4B21;
  --white: #FFFFFF;

  /* Text */
  --ink: #22332B;
  --muted-earth: #6B7C72;
  --muted: #5C6E63;
  --muted-soft: #7A8A80;
  --error: #8C342B;

  /* Structure */
  --border: #E2DED6;
  --border-strong: #D4CEC3;
  --border-control: #84968A;
  --shadow-card: 0 4px 14px rgba(0, 0, 0, 0.04);
  --shadow-float: 0 14px 38px rgba(34, 51, 43, 0.12);
  --radius-xl: 22px;
  --radius-lg: 18px;
  --radius-md: 14px;
  --radius-sm: 10px;

  /* Type */
  --font-ui: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-display: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;

  /* Motion */
  --ease: cubic-bezier(0.22, 0.8, 0.3, 1);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  -webkit-text-size-adjust: 100%;
}

body {
  min-width: 320px;
  min-height: 100vh;
  margin: 0;
  color: var(--ink);
  background-color: #F2EEE7;
  background-image:
    radial-gradient(circle at 12% 8%, rgba(82, 121, 111, 0.12), transparent 30%),
    radial-gradient(circle at 88% 92%, rgba(224, 169, 109, 0.13), transparent 28%);
  font-family: var(--font-ui);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  overflow-x: hidden;
}

body.modal-open {
  overflow: hidden;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  color: inherit;
}

a {
  color: var(--sage);
  text-underline-offset: 3px;
}

img,
svg {
  display: block;
  max-width: 100%;
}

[hidden] {
  display: none !important;
}

::selection {
  color: var(--white);
  background: var(--eucalyptus);
}

:focus-visible {
  outline: 3px solid rgba(63, 94, 77, 0.45);
  outline-offset: 3px;
}

/* ---------- Shell ---------- */

.app-frame {
  position: relative;
  width: 100%;
  max-width: 480px;
  min-height: 100vh;
  min-height: 100dvh;
  margin: 0 auto;
  background: var(--cream);
  border-inline: 1px solid rgba(34, 51, 43, 0.04);
  box-shadow: 0 20px 70px rgba(34, 51, 43, 0.08);
}

.skip-link {
  position: fixed;
  top: 10px;
  left: 10px;
  z-index: 200;
  padding: 12px 18px;
  color: var(--white);
  background: var(--sage);
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  transform: translateY(-160%);
  transition: transform 180ms var(--ease);
}

.skip-link:focus {
  transform: translateY(0);
}

/* ---------- Persistent emergency notice ---------- */

.emergency-banner {
  position: sticky;
  top: 0;
  z-index: 60;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: calc(10px + env(safe-area-inset-top)) 16px 10px;
