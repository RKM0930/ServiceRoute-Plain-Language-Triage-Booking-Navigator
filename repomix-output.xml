  margin-bottom: 14px;
}

.service-icon {
  display: grid;
  width: 47px;
  height: 47px;
  color: var(--sage);
  background: var(--sage-soft);
  border: 1px solid rgba(63, 94, 77, 0.08);
  border-radius: 14px;
  place-items: center;
}

.service-icon svg {
  width: 23px;
  height: 23px;
}

.service-tag {
  display: inline-flex;
  min-height: 26px;
  align-items: center;
  gap: 5px;
  padding: 5px 8px;
  color: var(--sage);
  background: var(--sage-wash);
  border: 1px solid #DDE8DE;
  border-radius: 999px;
  font-size: 8.75px;
  font-weight: 800;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.service-tag svg {
  width: 11px;
  height: 11px;
}

.service-title {
  position: relative;
  z-index: 1;
  margin: 0;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.025em;
}

.service-description {
  position: relative;
  z-index: 1;
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 12.5px;
  line-height: 1.58;
}

.fee-panel {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-top: 16px;
  padding: 12px 13px;
  background: #F8F5EE;
  border: 1px dashed #D8D0C2;
  border-radius: 12px;
}

.fee-label {
  flex: 1 1 auto;
  min-width: 0;
  color: var(--muted);
  font-size: 9.5px;
  font-weight: 800;
  line-height: 1.4;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.fee-label span {
  display: block;
  margin-top: 2px;
  color: var(--muted);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0;
  text-transform: none;
}

.fee-value {
  flex: 0 0 auto;
  color: var(--sage);
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.02em;
  text-align: right;
  white-space: nowrap;
}

.fee-value.is-custom {
  max-width: 150px;
  font-family: var(--font-ui);
  font-size: 12px;
  font-weight: 750;
  line-height: 1.35;
  letter-spacing: 0;
  white-space: normal;
}

.selection-chips {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 14px 0 0;
  padding: 0;
  list-style: none;
}

.selection-chips li {
  display: inline-flex;
  min-height: 28px;
  align-items: center;
  gap: 5px;
  padding: 5px 8px;
  color: #506258;
  background: #F6F5F1;
  border: 1px solid #E9E5DD;
  border-radius: 999px;
  font-size: 9.75px;
  font-weight: 650;
  line-height: 1.25;
}

.selection-chips svg {
  width: 11px;
  height: 11px;
  color: var(--eucalyptus);
}

.inquiry-card {
  margin-top: 14px;
  padding: 18px 17px 17px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
}

.inquiry-heading-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-bottom: 16px;
}

.inquiry-icon {
  display: grid;
  flex: 0 0 35px;
  width: 35px;
  height: 35px;
  color: var(--eucalyptus);
  background: #F2F6F2;
  border-radius: 11px;
  place-items: center;
}

.inquiry-icon svg {
  width: 17px;
  height: 17px;
}

.inquiry-title {
  margin: 0;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 21px;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.02em;
}

.inquiry-subtitle {
  margin: 2px 0 0;
  color: var(--muted);
  font-size: 11.25px;
  line-height: 1.48;
}

.field-group {
  margin-bottom: 13px;
}

.field-label {
  display: block;
  margin-bottom: 6px;
  color: var(--ink);
  font-size: 11.75px;
  font-weight: 750;
  line-height: 1.4;
}

.contact-input {
  width: 100%;
  min-height: 52px;
  padding: 12px 13px;
  color: var(--ink);
  background: #FDFCFA;
  border: 1.5px solid var(--border-control);
  border-radius: 12px;
  font-size: 15px;
  line-height: 1.35;
  outline: none;
  transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
  appearance: none;
}

.contact-input::placeholder {
  color: #63756A;
  opacity: 1;
}

.contact-input:hover {
  border-color: #6E8276;
}

.contact-input:focus {
  background: var(--white);
  border-color: var(--sage);
  box-shadow: 0 0 0 3px rgba(63, 94, 77, 0.12);
}

.contact-input[aria-invalid="true"] {
  background: #FFFDFC;
  border-color: var(--error);
}

.contact-input[aria-invalid="true"]:focus {
  box-shadow: 0 0 0 3px rgba(140, 52, 43, 0.12);
}

.field-hint {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 10.25px;
  line-height: 1.45;
}

.field-error {
  display: flex;
  align-items: flex-start;
  gap: 5px;
  margin: 6px 0 0;
  color: var(--error);
  font-size: 10.75px;
  font-weight: 650;
  line-height: 1.4;
}

.field-error svg {
  flex: 0 0 13px;
  width: 13px;
  height: 13px;
  margin-top: 1px;
}

.consent-card {
  display: flex;
  min-height: 48px;
  align-items: flex-start;
  gap: 10px;
  margin: 15px 0 14px;
  padding: 11px;
  background: var(--sage-wash);
  border: 1px solid #DDE7DE;
  border-radius: 12px;
  cursor: pointer;
  transition: border-color 180ms ease, background 180ms ease;
}

.consent-card:hover {
  background: #F1F6F1;
  border-color: #C9D9CB;
}

.consent-checkbox {
  display: grid;
  flex: 0 0 21px;
  width: 21px;
  height: 21px;
  margin: 1px 0 0;
  padding: 0;
  background: var(--white);
  border: 1.5px solid var(--border-control);
  border-radius: 6px;
  cursor: pointer;
  place-content: center;
  appearance: none;
  -webkit-appearance: none;
  transition: background 160ms ease, border-color 160ms ease;
}

.consent-checkbox::before {
  width: 10px;
  height: 6px;
  border-bottom: 2px solid var(--white);
  border-left: 2px solid var(--white);
  content: "";
  opacity: 0;
  transform: translateY(-1px) rotate(-45deg) scale(0.5);
  transition: opacity 160ms ease, transform 160ms ease;
}

.consent-checkbox:checked {
  background: var(--sage);
  border-color: var(--sage);
}

.consent-checkbox:checked::before {
  opacity: 1;
  transform: translateY(-1px) rotate(-45deg) scale(1);
}

.consent-checkbox:focus-visible {
  outline: 3px solid rgba(63, 94, 77, 0.32);
  outline-offset: 2px;
}

.consent-copy {
  color: #4F6157;
  font-size: 11.25px;
  line-height: 1.52;
}

.consent-copy strong {
  color: var(--ink);
  font-weight: 750;
}

.submit-button {
  width: 100%;
  min-height: 52px;
  font-size: 13px;
}

.form-privacy {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 5px;
  margin: 9px 0 0;
  color: var(--muted);
  font-size: 9.5px;
  line-height: 1.4;
  text-align: center;
}

.form-privacy svg {
  flex: 0 0 11px;
  width: 11px;
  height: 11px;
  margin-top: 1px;
}

/* ---------- Inquiry success ---------- */

.success-card {
  position: relative;
  margin-top: 14px;
  padding: 23px 18px 18px;
  overflow: hidden;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
  text-align: center;
  animation: success-in 420ms var(--ease) both;
}

.success-card::before {
  position: absolute;
  top: -55px;
  left: 50%;
  width: 142px;
  height: 142px;
  background: radial-gradient(circle, rgba(223, 235, 224, 0.82), rgba(238, 244, 239, 0));
  border-radius: 50%;
  content: "";
  pointer-events: none;
  transform: translateX(-50%);
}

.success-check {
  position: relative;
  z-index: 1;
  display: grid;
  width: 58px;
  height: 58px;
  margin: 0 auto 14px;
  color: var(--white);
  background: var(--sage);
  border-radius: 50%;
  box-shadow: 0 8px 22px rgba(63, 94, 77, 0.22);
  place-items: center;
  animation: check-pop 460ms 100ms var(--ease) both;
}

.success-check svg {
  width: 27px;
  height: 27px;
}

.success-kicker {
  position: relative;
  z-index: 1;
  margin: 0;
  color: var(--eucalyptus);
  font-size: 9.25px;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.success-title {
  position: relative;
  z-index: 1;
  margin: 4px 0 0;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 27px;
  font-weight: 600;
  line-height: 1.16;
  letter-spacing: -0.025em;
}

.success-message {
  position: relative;
  z-index: 1;
  max-width: 34ch;
  margin: 9px auto 0;
  color: var(--muted);
  font-size: 12.25px;
  line-height: 1.58;
}

.delivery-note {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: 7px;
  margin: 14px 0 0;
  padding: 9px 10px;
  color: var(--amber-ink);
  background: var(--amber-tint);
  border: 1px solid rgba(224, 169, 109, 0.54);
  border-radius: 10px;
  font-size: 10px;
  line-height: 1.48;
  text-align: left;
}

.delivery-note svg {
  flex: 0 0 13px;
  width: 13px;
  height: 13px;
  margin-top: 1px;
}

.success-actions {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 8px;
  margin-top: 17px;
}

.success-actions .button {
  width: 100%;
  min-height: 48px;
  font-size: 12.5px;
}

.success-start {
  color: var(--muted);
  background: transparent;
  border-color: transparent;
  box-shadow: none;
}

.success-start:hover {
  color: var(--ink);
  background: #F7F4ED;
}

/* ---------- Footer ---------- */

.site-footer {
  padding: 12px 18px 33px;
  color: var(--muted);
  text-align: center;
  transition: padding-bottom 250ms var(--ease);
}

body.has-dock .site-footer {
  padding-bottom: calc(126px + env(safe-area-inset-bottom));
}

.footer-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 12.5px;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.footer-brand svg {
  width: 14px;
  height: 14px;
  color: var(--eucalyptus);
}

.site-footer p {
  max-width: 36ch;
  margin: 5px auto 0;
  font-size: 9.5px;
  line-height: 1.55;
}

.site-footer .footer-privacy {
  margin-top: 8px;
  color: var(--eucalyptus);
  font-size: 8.75px;
  font-weight: 750;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

/* ---------- Crisis dialog ---------- */

.crisis-modal {
  width: min(calc(100vw - 30px), 414px);
  max-height: calc(100vh - 28px);
  max-height: calc(100dvh - 28px);
  margin: auto;
  padding: 20px;
  overflow-y: auto;
  color: var(--ink);
  background: var(--cream);
  border: 1px solid var(--border);
  border-radius: 24px;
  box-shadow: 0 30px 80px rgba(24, 37, 30, 0.28);
}

.crisis-modal[open] {
  animation: modal-in 260ms var(--ease) both;
}

.crisis-modal::backdrop {
  background: rgba(30, 44, 36, 0.5);
  -webkit-backdrop-filter: blur(3px);
  backdrop-filter: blur(3px);
}

.modal-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.modal-icon {
  display: grid;
  width: 44px;
  height: 44px;
  color: #925622;
  background: #FBE7D2;
  border: 1px solid rgba(224, 169, 109, 0.55);
  border-radius: 14px;
  place-items: center;
}

.modal-icon svg {
  width: 22px;
  height: 22px;
}

.modal-close {
  display: grid;
  width: 48px;
  height: 48px;
  margin: -9px -9px 0 0;
  padding: 0;
  color: var(--muted);
  background: transparent;
  border: 0;
  border-radius: 50%;
  cursor: pointer;
  place-items: center;
}

.modal-close:hover {
  color: var(--ink);
  background: #F2EDE5;
}

.modal-close svg {
  width: 18px;
  height: 18px;
}

.modal-kicker {
  margin: 14px 0 0;
  color: #92602E;
  font-size: 9.25px;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.crisis-modal h2 {
  margin: 5px 0 0;
  font-family: var(--font-display);
  font-size: 26px;
  font-weight: 600;
  line-height: 1.16;
  letter-spacing: -0.025em;
}

.crisis-modal > p:not(.modal-kicker):not(.modal-footnote) {
  margin: 9px 0 0;
  color: var(--muted);
  font-size: 12.5px;
  line-height: 1.58;
}

.hotline-card {
  display: grid;
  gap: 1px;
  margin-top: 14px;
  padding: 11px 13px;
  background: var(--amber-tint);
  border: 1px solid rgba(224, 169, 109, 0.6);
  border-radius: 12px;
}

.hotline-label {
  color: var(--amber-ink);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.hotline-card strong {
  color: #613B16;
  font-family: var(--font-display);
  font-size: 19px;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.015em;
}

.hotline-card strong span {
  color: var(--amber-ink);
  font-family: var(--font-ui);
  font-size: 10px;
  font-weight: 650;
  letter-spacing: 0;
}

.hotline-card a {
  display: inline-flex;
  width: fit-content;
  min-height: 48px;
  align-items: center;
  margin-bottom: -10px;
  color: var(--amber-ink);
  font-size: 12px;
  font-weight: 750;
}

.modal-actions {
  display: grid;
  gap: 8px;
  margin-top: 15px;
}

.modal-actions .button {
  width: 100%;
  min-height: 49px;
  font-size: 12px;
}

.crisis-modal .modal-footnote {
  margin: 11px 0 0;
  color: var(--muted);
  font-size: 9.5px;
  line-height: 1.45;
  text-align: center;
}

/* ---------- Toast ---------- */

.toast {
  position: fixed;
  right: 18px;
  bottom: calc(24px + env(safe-area-inset-bottom));
  left: 18px;
  z-index: 120;
  width: min(calc(100% - 36px), 444px);
  margin: 0 auto;
  padding: 11px 14px;
  color: var(--white);
  background: var(--ink);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(34, 51, 43, 0.24);
  font-size: 11.5px;
  font-weight: 650;
  line-height: 1.4;
  text-align: center;
  opacity: 0;
  transform: translateY(8px);
  transition: opacity 200ms ease, transform 200ms var(--ease);
}

body.has-dock .toast {
  bottom: calc(104px + env(safe-area-inset-bottom));
}

.toast.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* ---------- No-JS ---------- */

.noscript-card {
  margin-top: 18px;
  padding: 18px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
}

.noscript-card h2 {
  margin: 0;
  font-family: var(--font-display);
  font-size: 22px;
}

.noscript-card p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 13px;
}

/* ---------- Motion ---------- */

@keyframes step-in-forward {
  from {
    opacity: 0;
    transform: translateX(10px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes step-in-back {
  from {
    opacity: 0;
    transform: translateX(-10px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes panel-in {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes success-in {
  from {
    opacity: 0;
    transform: translateY(9px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes check-pop {
  0% {
    opacity: 0;
    transform: scale(0.65);
  }
  70% {
    opacity: 1;
    transform: scale(1.04);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes modal-in {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ---------- Small phones ---------- */

@media (max-width: 369px) {
  .emergency-banner {
    gap: 8px;
    padding-inline: 14px;
  }

  .emergency-banner p {
    font-size: 10.5px;
  }

  .app-header,
  .app-main {
    padding-inline: 15px;
  }

  .brand-name {
    font-size: 24px;
  }

  .brand-eyebrow {
    font-size: 8px;
  }

  .brand-mark {
    flex-basis: 41px;
    width: 41px;
    height: 41px;
  }

  .privacy-pill {
    padding-inline: 7px;
    font-size: 9px;
  }

  .progress-labels {
    font-size: 9px;
  }

  .step-heading {
    font-size: 24px;
  }

  .option-card {
    gap: 9px;
    padding: 12px;
  }

  .option-icon {
    flex-basis: 37px;
    width: 37px;
    height: 37px;
  }

  .option-title {
    font-size: 13.25px;
  }

  .option-detail {
    font-size: 10.75px;
  }

  .radio-mark {
    flex-basis: 18px;
    width: 18px;
    height: 18px;
  }

  .action-dock {
    padding-inline: 15px;
  }

  .action-dock-inner {
    padding: 8px;
  }

  .button {
    padding-inline: 12px;
    font-size: 12.75px;
  }

  .button-back {
    flex-basis: 78px;
  }

  .service-card,
  .inquiry-card {
    padding-inline: 15px;
  }

  .fee-panel {
    align-items: flex-start;
    flex-direction: column;
    gap: 5px;
  }

  .fee-value {
    text-align: left;
  }

  .crisis-modal {
    padding: 17px;
  }
}

/* ---------- Larger phones / small tablets ---------- */

@media (min-width: 481px) {
  .app-frame {
    min-height: 100dvh;
    border-inline: 1px solid rgba(34, 51, 43, 0.08);
  }
}

@media (min-width: 700px) {
  body {
    padding-block: 28px;
  }

  .app-frame {
    min-height: calc(100dvh - 56px);
    border: 1px solid rgba(34, 51, 43, 0.08);
    border-radius: 26px;
    box-shadow: 0 28px 90px rgba(34, 51, 43, 0.12);
  }

  .emergency-banner {
    border-radius: 26px 26px 0 0;
  }

  .site-footer {
    border-radius: 0 0 26px 26px;
  }

  .action-dock {
    bottom: 28px;
  }
}

/* ---------- Reduced motion ---------- */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto !important;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
