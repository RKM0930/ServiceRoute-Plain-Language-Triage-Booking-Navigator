  border-bottom: 1px solid var(--amber-line);
}

.emergency-icon {
  display: grid;
  flex: 0 0 27px;
  width: 27px;
  height: 27px;
  margin-top: 1px;
  color: #925622;
  background: #FBE7D2;
  border: 1px solid rgba(224, 169, 109, 0.55);
  border-radius: 50%;
